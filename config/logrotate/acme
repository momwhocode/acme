# Capistrano linked log directory (/var/www/acme/current/log -> shared/log).
# Installed to /etc/logrotate.d/acme by deploy:install_logrotate.

/var/www/acme/shared/log/production.log
/var/www/acme/shared/log/puma.log
/var/www/acme/shared/log/puma_error.log {
  su deploy deploy
  daily
  rotate 2
  maxage 2
  missingok
  notifempty
  compress
  delaycompress
  copytruncate
  dateext
  dateformat -%Y%m%d
}
