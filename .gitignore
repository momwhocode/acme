# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Bundler
/.bundle
/vendor/bundle
/vendor/cache

# Environment and secrets
/.env*
!/.env*.erb
/config/master.key
/config/credentials/*.key
*.pem
*.p12

# Logs and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
*.log
*.pid

# Pidfiles, but keep the directory
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Uploaded files and local SQLite
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*

# Compiled and generated frontend
/public/assets
/public/vite*
/storybook-static
/coverage
/node_modules
*.local
*.tsbuildinfo

# Vite / npm local caches
.vite
.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test and debug leftovers
/spec/examples.txt
.rspec_status
.byebug_history
.ruby-lsp

# OS and editor
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

docs/*